{
  "id": "wf_auto_moderation",
  "name": "群管理自动化",
  "description": "自动检测和处理群内不当行为",
  "enabled": true,
  "created_at": "2025-01-13T12:00:00", 
  "updated_at": "2025-01-13T12:00:00",
  "routes": [
    {
      "id": "route_spam_detection",
      "name": "垃圾信息检测",
      "rule_type": "regex",
      "condition": ".*(刷屏|灌水|广告|加群).*",
      "priority": 120,
      "enabled": true,
      "description": "检测可能的垃圾信息"
    }
  ],
  "steps": [
    {
      "id": "step_check_admin",
      "name": "检查是否为管理员",
      "type": "condition",
      "config": {
        "condition": "'ADMINS' in ${user_permissions}",
        "true_steps": ["step_ignore_admin"],
        "false_steps": ["step_check_severity"]
      },
      "enabled": true,
      "description": "管理员消息不处理"
    },
    {
      "id": "step_ignore_admin",
      "name": "忽略管理员",
      "type": "stop",
      "config": {},
      "enabled": true,
      "description": "管理员消息直接忽略"
    },
    {
      "id": "step_check_severity",
      "name": "评估严重程度",
      "type": "variable",
      "config": {
        "variable_name": "severity_score",
        "variable_value": "3"
      },
      "enabled": true,
      "description": "计算违规严重程度"
    },
    {
      "id": "step_warning_message",
      "name": "发送警告",
      "type": "message",
      "config": {
        "message": "⚠️ 警告 @${user_id}：检测到可能的不当内容，请注意群聊规范！\n\n如果是误判，请联系管理员说明情况。",
        "reply": true
      },
      "enabled": true,
      "description": "发送警告消息"
    },
    {
      "id": "step_log_incident",
      "name": "记录事件",
      "type": "variable",
      "config": {
        "variable_name": "incident_logged",
        "variable_value": "true"
      },
      "enabled": true,
      "description": "记录违规事件"
    },
    {
      "id": "step_notify_admin",
      "name": "通知管理员",
      "type": "message",
      "config": {
        "message": "📊 群管理自动化报告：\n用户 ${user_id} 触发了内容检测\n消息内容：${order}\n处理结果：已发送警告"
      },
      "enabled": true,
      "description": "向管理员发送通知"
    }
  ]
}